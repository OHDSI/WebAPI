<?xml version="1.0" encoding="UTF-8"?>
<!-- Build patched source dependencies and WebAPI together; no unpublished local artifacts required. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.ohdsi.webapi.security</groupId>
  <artifactId>webapi-security-reactor</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <!-- This alternate POM shares the application directory. Its final clean
       must never delete the WAR already built by the WebAPI reactor module. -->
  <build><directory>${project.basedir}/security-libs/target/reactor</directory></build>
  <modules>
    <module>security-libs</module>
    <module>security-libs/common-utils</module>
    <module>security-libs/data-source-manager</module>
    <module>pom.xml</module>
  </modules>
  <profiles>
    <profile>
      <id>webapi-gis</id>
      <modules><module>security-libs/atlasgis</module></modules>
    </profile>
  </profiles>
</project>
