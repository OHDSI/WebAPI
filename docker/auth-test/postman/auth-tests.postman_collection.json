    {
      "name": "JDBC Authentication",
      "item": [
        {
          "name": "JDBC Login - Valid Credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('JDBC login returns 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Extract JWT token from response body",
                  "const jsonData = pm.response.json();",
                  "if (jsonData && jsonData.jwt) {",
                  "    pm.collectionVariables.set('jdbc_token', jsonData.jwt);",
                  "    pm.test('JWT token received in response body', function() {",
                  "        pm.expect(jsonData.jwt).to.not.be.empty;",
                  "        pm.expect(jsonData.jwt).to.include('.');",
                  "    });",
                  "} else {",
                  "    pm.test('JWT should be present in response', function() {",
                  "        pm.expect(jsonData.jwt).to.not.be.undefined;",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "login",
                  "value": "testuser@example.com"
                },
                {
                  "key": "password",
                  "value": "testpass123"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/user/login/db",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "user",
                "login",
                "db"
              ]
            }
          }
        },
        {
          "name": "JDBC Login - Invalid Credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Invalid credentials return 401', function() {",
