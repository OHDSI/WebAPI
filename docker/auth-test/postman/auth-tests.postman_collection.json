            "body": {
              "mode": "urlencoded",
              "urlencoded": []
            },
            "url": {
              "raw": "{{base_url}}/user/login/db",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "user",
                "login",
                "db"
              ]
            }
          }
        },
        {
          "name": "Access Protected Endpoint with JDBC Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// This test runs after successful JDBC login",
                  "const token = pm.collectionVariables.get('jdbc_token');",
                  "if (token) {",
                  "    pm.test('Protected endpoint accessible with valid token', function() {",
                  "        pm.expect(pm.response.code).to.be.oneOf([200, 403]);",
                  "    });",
                  "} else {",
                  "    pm.test.skip('No JDBC token available');",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const token = pm.collectionVariables.get('jdbc_token');",
                  "if (token) {",
                  "    pm.request.headers.add({",
                  "        key: 'Authorization',",
                  "        value: 'Bearer ' + token",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/user/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "user",
                "me"
              ]
            }
          }
