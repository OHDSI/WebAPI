            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Missing credentials are handled', function() {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 400, 401, 403]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
