# TCP address and port the server binds to
PORT=8080
HOST=0.0.0.0

# Path to the SQLite database file
DB_PATH=/data/webapi.db

# Version string reported by GET /info
WEBAPI_VERSION=2.15.1

# HTTP request header that carries the authenticated username (set by nginx)
WEBAPI_AUTH_HEADER=x-forwarded-user

# JSON array of CDM source definitions.
# Each entry must have at minimum: sourceKey, sourceName, cdmSchema, vocabSchema,
# resultsSchema, tempSchema, and either connectionString or (server + database +
# username + password).
#
# Using a connection string:
# WEBAPI_SOURCES=[{"sourceKey":"cdm1","sourceName":"My CDM","connectionString":"Server=host,1433;Database=cdm;Encrypt=true;","username":"user","password":"pass","cdmSchema":"dbo","vocabSchema":"dbo","resultsSchema":"results","tempSchema":"temp"}]
#
# Using discrete properties:
# WEBAPI_SOURCES=[{"sourceKey":"cdm1","sourceName":"My CDM","server":"host","port":1433,"database":"cdm","username":"user","password":"pass","encrypt":true,"trustServerCertificate":false,"cdmSchema":"dbo","vocabSchema":"dbo","resultsSchema":"results","tempSchema":"temp"}]
WEBAPI_SOURCES=[]
